<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background"
    android:padding="16dp">

    <!-- Left side: Logo and Title -->
    <LinearLayout
        android:id="@+id/leftPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.35">

        <!-- App Logo/Icon -->
        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App logo"/>

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 Ship 2 Harkinian"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:gravity="center"/>

        <!-- Supported ROM Info -->
        <TextView
            android:id="@+id/supportedRomsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Supported: MM US 1.0, MM GC\nFormats: .z64, .n64, .v64"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <!-- Version Info -->
        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 3.0.1"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Right side: ROM Selection Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/romCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/card_background"
        app:layout_constraintStart_toEndOf="@id/leftPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Instructions -->
            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a valid Majora's Mask ROM"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"/>

            <!-- Select ROM Button -->
            <Button
                android:id="@+id/selectRomButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Select ROM File"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary"
                android:textColor="@android:color/white"
                android:drawableStart="@drawable/ic_folder_open"
                android:drawablePadding="8dp"
                android:layout_marginTop="12dp"/>

            <!-- Selected File Name -->
            <TextView
                android:id="@+id/selectedFileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:ellipsize="middle"
                android:singleLine="true"/>

            <!-- Status Text -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No ROM selected"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="6dp"/>

            <!-- Confirm Button (hidden until ROM validated) -->
            <Button
                android:id="@+id/confirmButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Continue"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/success"
                android:textColor="@android:color/white"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>

            <!-- Progress Container (initially hidden) -->
            <LinearLayout
                android:id="@+id/progressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary"/>

                <!-- Progress Percentage -->
                <TextView
                    android:id="@+id/progressPercent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
